#!/usr/bin/env bash
set -euo pipefail

# scripts/verify-public-push
# Verifies a published public clone for security, license conformance, single commit, identities, tree hash, and test health.
# Usage: ./scripts/verify-public-push <repo-url-or-dir> [<expected-tree-hash>]

TARGET="${1:-}"
EXPECTED_TREE="${2:-}"

if [ -z "$TARGET" ]; then
  echo "Usage: $0 <repo-url-or-path> [<expected-tree-hash>]"
  exit 1
fi

TMP_CLONE=$(mktemp -d)
trap 'rm -rf "$TMP_CLONE"' EXIT

echo "=========================================================="
echo " ROOTINBOX PUBLIC PUSH ANONYMOUS VERIFIER"
echo " Target: $TARGET"
echo " Temp Directory: $TMP_CLONE"
echo "=========================================================="

echo "[1/8] Cloning target repository anonymously (full history)..."
git clone "$TARGET" "$TMP_CLONE"

cd "$TMP_CLONE"

echo "[2/8] Verifying commit count equals 1 (single root commit)..."
COMMIT_COUNT=$(git rev-list --count HEAD)
if [ "$COMMIT_COUNT" -ne 1 ]; then
  echo "[-] ERROR: Commit count is $COMMIT_COUNT (expected exactly 1 root commit)! History leak detected!"
  exit 1
fi
echo "[+] Verified commit count: 1 (clean orphan export)"

echo "[3/8] Verifying git author and committer identities..."
AUTHOR=$(git log -1 --format="%an <%ae>")
COMMITTER=$(git log -1 --format="%cn <%ce>")
EXPECTED_ID="yasinif <294417245+yasinif@users.noreply.github.com>"

if [ "$AUTHOR" != "$EXPECTED_ID" ]; then
  echo "[-] ERROR: Author ($AUTHOR) does not match expected identity ($EXPECTED_ID)!"
  exit 1
fi
if [ "$COMMITTER" != "$EXPECTED_ID" ]; then
  echo "[-] ERROR: Committer ($COMMITTER) does not match expected identity ($EXPECTED_ID)!"
  exit 1
fi
PARENTS=$(git log -1 --format="%P")
if [ -n "$PARENTS" ]; then
  echo "[-] ERROR: Commit is not an orphan root commit (has parents: $PARENTS)!"
  exit 1
fi
echo "[+] Verified commit author and committer: $AUTHOR"

echo "[4/8] Verifying tree hash integrity..."
TREE_HASH=$(git rev-parse 'HEAD^{tree}')
if [ -n "$EXPECTED_TREE" ]; then
  if [ "$TREE_HASH" != "$EXPECTED_TREE" ]; then
    echo "[-] ERROR: Tree hash ($TREE_HASH) does not match expected export tree ($EXPECTED_TREE)!"
    exit 1
  fi
  echo "[+] Verified tree hash matches expected: $TREE_HASH"
else
  echo "[+] Cloned tree hash: $TREE_HASH"
fi

echo "[5/8] Verifying deny-list files are absent..."
DENY_FILES=("task.md" "UI_UX_SKILL.md" "docs/design/UI_UX_SKILL.md" "DECISIONS_LOG.md" "agent-progress.md")
for df in "${DENY_FILES[@]}"; do
  if [ -e "$df" ]; then
    echo "[-] ERROR: Deny-list file detected in repository: $df"
    exit 1
  fi
done
if find . -name "*agent-logs*" | grep -q .; then
  echo "[-] ERROR: agent-logs directory or file detected in repository!"
  exit 1
fi
echo "[+] Verified all deny-list files are absent"

echo "[6/8] Verifying AGPL-3.0 LICENSE..."
if [ ! -f "LICENSE" ]; then
  echo "[-] ERROR: LICENSE file missing!"
  exit 1
fi
if ! grep -q "GNU AFFERO GENERAL PUBLIC LICENSE" LICENSE || ! grep -q "Version 3" LICENSE; then
  echo "[-] ERROR: LICENSE is not AGPL-3.0!"
  exit 1
fi
echo "[+] Verified AGPL-3.0 LICENSE"

echo "[7/8] Running security and public readiness audit scanner..."
if [ -f "scripts/public-readiness" ]; then
  node scripts/public-readiness .
else
  echo "[!] scripts/public-readiness not present in tree; skipping scanner"
fi

if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  echo "[-] Running Gitleaks credential scan via official container..."
  docker run --rm -v "${TMP_CLONE}:/path" zricethezav/gitleaks:latest detect --source="/path" --no-git --report-format=json --report-path=/path/gitleaks-report.json || true
  if [ -f "gitleaks-report.json" ]; then
    LIVE_LEAKS=$(node -e '
      const report = JSON.parse(fs.readFileSync("gitleaks-report.json", "utf8"));
      const allowedDummy = [
        "AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA",
        "12345678901234567890123456789012",
        "abcdefabcdefabcdefabcdefabcdefab",
        "test_prev_secret",
        "0123456789abcdef"
      ];
      const leaks = report.filter(f => {
        if (f.File.includes("crypto-vectors") || f.File.includes("vapid-migration") || f.File.includes("test") || f.File.includes("router_test")) return false;
        if (allowedDummy.some(d => f.Secret.includes(d))) return false;
        return true;
      });
      if (leaks.length > 0) {
        console.log(leaks.map(l => `${l.File} (${l.RuleID})`).join(", "));
        process.exit(1);
      }
    ' 2>&1 || echo "LEAK_FOUND")
    rm -f "gitleaks-report.json"
    if [ "$LIVE_LEAKS" = "LEAK_FOUND" ]; then
      echo "[-] ERROR: Gitleaks detected unauthorized live credentials!"
      exit 1
    fi
  fi
  echo "[+] Verified Gitleaks scan: zero live secrets detected"
else
  echo "[!] Docker daemon not available; relying on regex scanner"
fi

echo "[8/8] Running backend test suite on clean clone..."
go test ./...

echo "=========================================================="
echo " VERIFICATION COMPLETE: ALL 8/8 CHECKS PASSED"
echo " Target is verified 100% clean, single-commit public export."
echo "=========================================================="
