#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# RootInbox Air-Gapped Isolation & Weak-VPS Resource Gates Drill
# ==============================================================================
# Verifies:
#  1. Binary Size Gate: <= 25 MB (26,214,400 bytes)
#  2. Network Isolation: Docker --internal network (Zero outbound egress / no gateway)
#  3. Strict Host Boundaries: Non-root user (1001:1001), 512 MB RAM, 1 CPU
#  4. Cold Start Gate: <= 2000 ms to HTTP 200 readiness
#  5. Idle RSS Gate (10 clients): <= 100 MB (104,857,600 bytes)
#  6. No OOM Kill under 512 MB constraint
#  7. Exploratory Run under 256 MB RAM constraint
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

BINARY_PATH="${1:-${ROOT_DIR}/dist/rootinbox-linux-amd64}"
if [[ "$BINARY_PATH" != /* ]]; then
  BINARY_PATH="$PWD/$BINARY_PATH"
fi

echo "======================================================================"
echo "RootInbox Air-Gapped Isolation & Weak-VPS Resource Gates Drill"
echo "======================================================================"
echo "Target Binary: $BINARY_PATH"

# 0. Ensure binary exists (strict gate: must fail if binary is missing)
if [ ! -f "$BINARY_PATH" ]; then
  echo "[-] ERROR: Target binary not found at $BINARY_PATH" >&2
  exit 1
fi

chmod +x "$BINARY_PATH"

FAILED_GATES=0

# ==============================================================================
# GATE 1: Binary Size Gate (<= 25 MB)
# ==============================================================================
echo ""
echo "--- [GATE 1] Binary Size Verification ---"
BIN_SIZE_BYTES=$(stat -c %s "$BINARY_PATH" 2>/dev/null || stat -f %z "$BINARY_PATH")
BIN_SIZE_MB=$(awk -v b="$BIN_SIZE_BYTES" 'BEGIN { printf "%.2f", b / (1024 * 1024) }')
MAX_BIN_BYTES=26214400 # 25 MB

echo "Binary Size: $BIN_SIZE_BYTES bytes (${BIN_SIZE_MB} MB)"
if [ "$BIN_SIZE_BYTES" -le "$MAX_BIN_BYTES" ]; then
  echo "[PASS] Gate 1: Binary size is within 25 MB budget."
else
  echo "[FAIL] Gate 1: Binary size exceeds 25 MB budget (${BIN_SIZE_MB} MB > 25.00 MB)!"
  FAILED_GATES=$((FAILED_GATES + 1))
fi

# If Docker is not available in the current environment, provide fallback notice
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  echo ""
  echo "[-] WARNING: Docker daemon is not available in the current runtime environment."
  echo "[-] Local verification completed Gate 1 (Binary Size). Docker-based gates will execute in CI."
  if [ "$FAILED_GATES" -gt 0 ]; then
    exit 1
  fi
  exit 0
fi

# Clean up any leftover test containers and networks
cleanup() {
  echo ""
  echo "[*] Cleaning up test containers and networks..."
  docker rm -f rootinbox-iso-512m rootinbox-iso-256m rootinbox-iso-client rootinbox-snoop >/dev/null 2>&1 || true
  docker network rm isolation_test_net >/dev/null 2>&1 || true
  rm -rf /tmp/iso-512m-data /tmp/iso-256m-data /tmp/iso-tls /tmp/iso-media /tmp/iso-rehearsal >/dev/null 2>&1 || true
}
trap cleanup EXIT
cleanup

# ==============================================================================
# GATE 2: Air-Gapped Network Isolation (--internal, Zero Outbound Egress)
# ==============================================================================
echo ""
echo "--- [GATE 2] Zero-Egress Air-Gapped Network Setup ---"
docker network create --internal --subnet=172.29.240.0/24 isolation_test_net
echo "[+] Created strictly internal Docker network (no default gateway, no external routing)."

# Prepare temp directories with 1001:1001 permissions
mkdir -p /tmp/iso-512m-data/tls /tmp/iso-512m-data/media
chmod -R 777 /tmp/iso-512m-data

RAND_SECRET="1234567890123456789012345678901234567890123456789012345678901234"

# Launch container with 512m RAM, 1 CPU, non-root user 1001:1001 on internal network
echo "[+] Starting RootInbox container on isolated internal network (512 MB RAM, 1 CPU, user 1001:1001)..."
docker run -d \
  --name rootinbox-iso-512m \
  --network isolation_test_net \
  --ip 172.29.240.10 \
  --memory=512m \
  --memory-swap=512m \
  --cpus=1.0 \
  --user 1001:1001 \
  -v "$BINARY_PATH:/rootinbox:ro" \
  -v /tmp/iso-512m-data:/data \
  -v /tmp/iso-512m-data/tls:/data/tls \
  -v /tmp/iso-512m-data/media:/data/media \
  -e SERVER_HOST=0.0.0.0 \
  -e PORT=8443 \
  -e PUBLIC_HOST=172.29.240.10 \
  -e TLS_MODE=selfsigned \
  -e TLS_DATA_DIR=/data/tls \
  -e TLS_ONBOARDING_PORT=8080 \
  -e IP_HASH_SECRET="$RAND_SECRET" \
  -e DB_PATH=/data/rootinbox.db \
  -e MEDIA_PATH=/data/media \
  -e LOG_LEVEL=info \
  -e PUSH_ENABLED=false \
  alpine:latest /rootinbox

# ==============================================================================
# GATE 3: Cold Start Verification (<= 2000 ms)
# ==============================================================================
echo ""
echo "--- [GATE 3] Cold Start Measurement ---"

START_NS=$(date +%s%N)
READY=0
for i in $(seq 1 100); do
  # Check readiness from inside the internal network
  STATUS=$(docker run --rm --network isolation_test_net curlimages/curl:latest -s -o /dev/null -w "%{http_code}" --connect-timeout 1 http://172.29.240.10:8080/ca.crt 2>/dev/null || echo "000")
  if [ "$STATUS" = "200" ]; then
    END_NS=$(date +%s%N)
    READY=1
    break
  fi
  sleep 0.05
done

if [ "$READY" -eq 1 ]; then
  ELAPSED_MS=$(( (END_NS - START_NS) / 1000000 ))
  echo "Cold start ready in: ${ELAPSED_MS} ms"
  if [ "$ELAPSED_MS" -le 2000 ]; then
    echo "[PASS] Gate 3: Cold start completed in <= 2000 ms (${ELAPSED_MS} ms)."
  else
    echo "[FAIL] Gate 3: Cold start exceeded 2000 ms threshold (${ELAPSED_MS} ms)!"
    FAILED_GATES=$((FAILED_GATES + 1))
  fi
else
  echo "[FAIL] Gate 3: Server failed to become ready within timeout!"
  docker logs rootinbox-iso-512m
  FAILED_GATES=$((FAILED_GATES + 1))
fi

# ==============================================================================
# GATE 4: Zero External Egress Verification
# ==============================================================================
echo ""
echo "--- [GATE 4] External Egress Isolation Proof ---"

# 1. Attempt outbound connection to public internet from internal network (must fail)
EGRESS_ATTEMPT=$(docker run --rm --network isolation_test_net alpine:latest sh -c "nc -z -w 2 8.8.8.8 53 || echo 'BLOCKED'" 2>&1 || echo "BLOCKED")
if echo "$EGRESS_ATTEMPT" | grep -q "BLOCKED"; then
  echo "[+] Internal network confirmed: Outbound internet routing is physically blocked by Docker."
else
  echo "[-] ERROR: Internal network permitted external routing!"
  FAILED_GATES=$((FAILED_GATES + 1))
fi

# 2. Inspect server container logs to ensure zero outbound connection errors / phone-home calls
SERVER_LOGS=$(docker logs rootinbox-iso-512m 2>&1)
if echo "$SERVER_LOGS" | grep -iE 'telemetry|analytics|phone_home|update_check|segment|sentry'; then
  echo "[-] ERROR: Detected telemetry or phone-home requests in server logs!"
  FAILED_GATES=$((FAILED_GATES + 1))
else
  echo "[PASS] Gate 4: Zero outbound telemetry, phone-home, or unrouted external calls verified."
fi

# ==============================================================================
# GATE 5: Idle RSS with 10 Active Clients (<= 100 MB) & No OOM at 512 MB
# ==============================================================================
echo ""
echo "--- [GATE 5] Idle RSS (10 Clients) & Memory Gate (512 MB) ---"

# Register 10 clients inside the isolated network
echo "[+] Simulating and registering 10 clients inside isolated container..."
for c in $(seq 1 10); do
  PAYLOAD="{\"username\":\"iso_user_${c}\",\"display_name\":\"User ${c}\",\"password\":\"Password123!\"}"
  docker run --rm --network isolation_test_net curlimages/curl:latest -s -k -X POST \
    -H "Content-Type: application/json" \
    -d "$PAYLOAD" \
    https://172.29.240.10:8443/api/v1/auth/register >/dev/null 2>&1 || true
done
echo "[+] 10 clients registered and established."

sleep 2

# Measure container memory usage
MEM_USAGE_RAW=$(docker stats --no-stream --format "{{.MemUsage}}" rootinbox-iso-512m)
echo "Container memory report: $MEM_USAGE_RAW"

# Extract memory in MB
MEM_VAL=$(echo "$MEM_USAGE_RAW" | awk '{print $1}')
MEM_UNIT=$(echo "$MEM_USAGE_RAW" | awk '{print $1}' | sed 's/[0-9.]//g')
MEM_NUM=$(echo "$MEM_USAGE_RAW" | awk '{print $1}' | sed 's/[A-Za-z]//g')

# Calculate RSS in MB
if [ "$MEM_UNIT" = "GiB" ] || [ "$MEM_UNIT" = "GB" ]; then
  MEM_MB=$(awk -v n="$MEM_NUM" 'BEGIN { printf "%.2f", n * 1024 }')
else
  MEM_MB=$(awk -v n="$MEM_NUM" 'BEGIN { printf "%.2f", n }')
fi

echo "Current RSS (with 10 clients): ${MEM_MB} MB (Gate: <= 100 MB)"

# Check OOM status
OOM_KILLED=$(docker inspect -f '{{.State.OOMKilled}}' rootinbox-iso-512m)
echo "Container OOM Killed: $OOM_KILLED"

if [ "$OOM_KILLED" = "false" ]; then
  echo "[PASS] Gate 5a: Container did not trigger OOM killer under 512 MB memory limit."
else
  echo "[FAIL] Gate 5a: Container was killed by OOM under 512 MB!"
  FAILED_GATES=$((FAILED_GATES + 1))
fi

MEM_CHECK=$(awk -v m="$MEM_MB" 'BEGIN { if (m <= 100.0) print 1; else print 0 }')
if [ "$MEM_CHECK" -eq 1 ]; then
  echo "[PASS] Gate 5b: RSS with 10 clients (${MEM_MB} MB) is well within 100 MB budget."
else
  echo "[FAIL] Gate 5b: RSS with 10 clients (${MEM_MB} MB) exceeded 100 MB budget!"
  FAILED_GATES=$((FAILED_GATES + 1))
fi

# ==============================================================================
# GATE 6: Exploratory Run Under 256 MB RAM Constraint
# ==============================================================================
echo ""
echo "--- [GATE 6] Exploratory Run Under 256 MB Constraint ---"

mkdir -p /tmp/iso-256m-data/tls /tmp/iso-256m-data/media
chmod -R 777 /tmp/iso-256m-data

echo "[+] Starting RootInbox container on isolated network with 256 MB RAM limit..."
docker run -d \
  --name rootinbox-iso-256m \
  --network isolation_test_net \
  --ip 172.29.240.20 \
  --memory=256m \
  --memory-swap=256m \
  --cpus=1.0 \
  --user 1001:1001 \
  -v "$BINARY_PATH:/rootinbox:ro" \
  -v /tmp/iso-256m-data:/data \
  -v /tmp/iso-256m-data/tls:/data/tls \
  -v /tmp/iso-256m-data/media:/data/media \
  -e SERVER_HOST=0.0.0.0 \
  -e PORT=8443 \
  -e PUBLIC_HOST=172.29.240.20 \
  -e TLS_MODE=selfsigned \
  -e TLS_DATA_DIR=/data/tls \
  -e TLS_ONBOARDING_PORT=8080 \
  -e IP_HASH_SECRET="$RAND_SECRET" \
  -e DB_PATH=/data/rootinbox.db \
  -e MEDIA_PATH=/data/media \
  -e LOG_LEVEL=info \
  -e PUSH_ENABLED=false \
  alpine:latest /rootinbox

# Wait for readiness
READY_256=0
for i in $(seq 1 40); do
  STATUS=$(docker run --rm --network isolation_test_net curlimages/curl:latest -s -o /dev/null -w "%{http_code}" --connect-timeout 1 http://172.29.240.20:8080/ca.crt 2>/dev/null || echo "000")
  if [ "$STATUS" = "200" ]; then
    READY_256=1
    break
  fi
  sleep 0.1
done

if [ "$READY_256" -eq 1 ]; then
  MEM_256_RAW=$(docker stats --no-stream --format "{{.MemUsage}}" rootinbox-iso-256m)
  OOM_256=$(docker inspect -f '{{.State.OOMKilled}}' rootinbox-iso-256m)
  echo "256 MB Container Memory: $MEM_256_RAW (OOM: $OOM_256)"
  if [ "$OOM_256" = "false" ]; then
    echo "[PASS] Gate 6: Server successfully starts, generates CA, and serves HTTP in 256 MB RAM container without OOM."
  else
    echo "[FAIL] Gate 6: Server OOM-killed in 256 MB container!"
    FAILED_GATES=$((FAILED_GATES + 1))
  fi
else
  echo "[FAIL] Gate 6: Server failed to become ready under 256 MB RAM limit!"
  docker logs rootinbox-iso-256m
  FAILED_GATES=$((FAILED_GATES + 1))
fi

# ==============================================================================
# Drill Summary
# ==============================================================================
echo ""
echo "======================================================================"
echo "ISOLATION DRILL SUMMARY REPORT"
echo "======================================================================"
echo "Gate 1 (Binary Size <= 25 MB):         ${BIN_SIZE_MB} MB"
echo "Gate 2 (Docker --internal Network):    ISOLATED (Zero Outbound Egress)"
echo "Gate 3 (Cold Start <= 2000 ms):        ${ELAPSED_MS} ms"
echo "Gate 4 (Zero Outbound Telemetry):      CONFIRMED"
echo "Gate 5 (Idle RSS with 10 clients):     ${MEM_MB} MB (OOM: ${OOM_KILLED})"
echo "Gate 6 (Exploratory 256 MB Run):       ${MEM_256_RAW} (OOM: ${OOM_256})"
echo "======================================================================"

if [ "$FAILED_GATES" -gt 0 ]; then
  echo "[-] DRILL FAILED: $FAILED_GATES gates failed!"
  exit 1
fi

echo "[+] ALL GATES PASSED SUCCESSFULLY!"
exit 0
